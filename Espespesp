local function t(u,v)
	if i[u] then return end
	i[u] = true

	local w = u:WaitForChild("Humanoid",5)
	local x = u:WaitForChild("Head",5)
	if not w or not x then return end

	local y = v and h.Killer or h.Survivor
	local z,aa = n(u,x,u.Name)
	aa.TextColor3 = y

	local ab = Instance.new("Highlight")
	ab.Adornee = u
	ab.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	ab.FillColor = y
	ab.OutlineColor = y
	ab.FillTransparency = 0.9
	ab.Parent = u

	local ac
	if not v then
		w.HealthChanged:Connect(function(ad)
			if ad <= 50 then
				if not ac then
					ac = b.Heartbeat:Connect(function()
						local ae = tick() % 2
						if ae < 1 then
							aa.TextColor3 = h.RED
						else
							aa.TextColor3 = y
						end
					end)
				end
			else
				if ac then ac:Disconnect() ac=nil end
				aa.TextColor3 = y
			end
		end)
	end

	w.Died:Once(function()
		if ac then ac:Disconnect() end
		z:Destroy()
		ab:Destroy()
		i[u] = nil
	end)
end

